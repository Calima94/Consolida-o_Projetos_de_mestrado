# The course project's LSTM (mestrado_emg/lstm_gestos.py), in its own image:
# PyTorch for CPU is ~700 MB installed and nothing in the ROS image needs it.
#   docker compose -f docker/compose.yaml --profile lstm build lstm
#   docker compose -f docker/compose.yaml --profile lstm run --rm lstm
# Only the pure-Python modules it imports are copied (numpy, pandas, torch;
# matplotlib for the figures); no ROS.
FROM python:3.12-slim

ARG TORCH_VERSION=2.14.0+cpu
RUN pip install --no-cache-dir "torch==${TORCH_VERSION}" \
        --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir numpy==2.5.3 pandas==3.0.6 matplotlib==3.11.2 pytest==8.4.2 \
 && python -c "import torch; print('torch', torch.__version__)"

ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1 MPLCONFIGDIR=/tmp/matplotlib
WORKDIR /app
COPY ros2_ws/src/mestrado_emg/mestrado_emg/__init__.py ros2_ws/src/mestrado_emg/mestrado_emg/lstm_gestos.py /app/mestrado_emg/
